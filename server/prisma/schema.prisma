// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

enum UserRole {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum ActionState {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id                 Int          @id @default(autoincrement())
  displayName        String       @db.VarChar(120)
  email              String       @unique @db.VarChar(320)
  isActive           Boolean      @default(true)
  role               UserRole     @default(REQUESTER)
  passwordHash       String?
  mustChangePassword Boolean      @default(true)
  version            Int          @default(1)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt
  tickets            Ticket[]     @relation("TicketRequester")
  removedAttachments Attachment[] @relation("AttachmentRemovedBy")
  sessions           Session[]
  ownedTickets       Ticket[]     @relation("TicketOwner")
  publicComments     PublicComment[]
  internalNotes      InternalNote[]
  createdActions     ActionTaken[] @relation("ActionCreator")
  performedActions   ActionTaken[] @relation("ActionPerformer")
  assignedActions    ActionTaken[] @relation("ActionAssignee")
  actionEvents       ActionTakenEvent[]
  actionReceipts     ActionWriteReceipt[]
  ticketTransitions  TicketTransitionEvent[]
}

model Session {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @unique @db.VarChar(64)
  csrfHash   String   @db.VarChar(64)
  userId     Int
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tickets   Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  tickets   Ticket[]
}

model Ticket {
  id                Int                @id @default(autoincrement())
  ownerId           Int?
  version           Int                @default(1)
  requesterResolutionIndicatedAt DateTime?
  resolutionCycle   Int                @default(1)
  resolvedAt        DateTime?          @db.Timestamptz(3)
  owner             User?              @relation("TicketOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  ticketNumber      String             @unique @db.VarChar(32)
  requesterId       Int
  categoryId        Int
  relatedSystemId   Int
  summary           String             @db.VarChar(120)
  description       String             @db.VarChar(4000)
  requestedPriority RequestedPriority
  itPriority        RequestedPriority
  status            TicketStatus       @default(NEW)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  requester         User               @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  relatedSystem     RelatedSystem      @relation(fields: [relatedSystemId], references: [id], onDelete: Restrict)
  attachments       Attachment[]
  publicComments    PublicComment[]
  internalNotes     InternalNote[]
  actions           ActionTaken[]
  actionEvents      ActionTakenEvent[]
  actionReceipts    ActionWriteReceipt[]
  transitionEvents  TicketTransitionEvent[]

  @@index([requesterId, updatedAt])
  @@index([ownerId, status])
  @@index([requesterId, status])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([status, itPriority])
  @@index([requesterId, resolvedAt])
  @@index([updatedAt, id])
}

model ActionTaken {
  id                 Int @id @default(autoincrement())
  ticketId           Int
  cycle              Int
  state              ActionState @default(PLANNED)
  actionAt           DateTime @db.Timestamptz(3)
  description        String @db.VarChar(4000)
  result             String @db.VarChar(4000)
  assigneeId         Int?
  createdById        Int
  performedById      Int?
  performedAt        DateTime? @db.Timestamptz(3)
  followUpRequired   Boolean @default(false)
  followUpNote       String @db.VarChar(2000)
  attachmentNotes    String @db.VarChar(2000)
  cancellationReason String? @db.VarChar(500)
  version            Int @default(1)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  ticket             Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  createdBy          User @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  performedBy        User? @relation("ActionPerformer", fields: [performedById], references: [id], onDelete: Restrict)
  assignee           User? @relation("ActionAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  events             ActionTakenEvent[]
  receipts           ActionWriteReceipt[]

  @@unique([id, ticketId])
  @@index([ticketId, cycle, createdAt, id])
  @@index([assigneeId, state])
  @@index([performedById, performedAt, id])
}

model ActionTakenEvent {
  id        Int @id @default(autoincrement())
  actionId  Int
  ticketId  Int
  actorId   Int
  kind      String @db.VarChar(32)
  version   Int
  reason    String? @db.VarChar(500)
  before    Json? @db.JsonB
  after     Json @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  action    ActionTaken @relation(fields: [actionId, ticketId], references: [id, ticketId], onDelete: Restrict)
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor     User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  receipts  ActionWriteReceipt[]

  @@unique([actionId, version])
  @@unique([id, actionId, ticketId])
  @@index([ticketId, createdAt, id])
  @@index([actionId, createdAt, id])
}

model ActionWriteReceipt {
  id            Int @id @default(autoincrement())
  ticketId      Int
  actorId       Int
  requestId     String @db.Uuid
  operation     String @db.VarChar(100)
  payloadHash   String @db.VarChar(64)
  actionId      Int
  eventId       Int
  actionVersion Int
  ticketVersion Int
  ticket        Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor         User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action        ActionTaken @relation(fields: [actionId, ticketId], references: [id, ticketId], onDelete: Restrict)
  event         ActionTakenEvent @relation(fields: [eventId, actionId, ticketId], references: [id, actionId, ticketId], onDelete: Restrict)

  @@unique([ticketId, actorId, requestId])
}

model TicketTransitionEvent {
  id            Int @id @default(autoincrement())
  ticketId      Int
  actorId       Int
  fromStatus    TicketStatus
  toStatus      TicketStatus
  cycle         Int
  ticketVersion Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  ticket        Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actor         User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([ticketId, ticketVersion])
  @@index([ticketId, createdAt, id])
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.VarChar(4000)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String   @db.VarChar(4000)
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
}

model Attachment {
  id                   Int            @id @default(autoincrement())
  ticketId             Int
  originalName         String         @db.VarChar(120)
  storedName           String         @unique @db.VarChar(100)
  mimeType             String         @db.VarChar(100)
  sizeBytes            Int
  createdAt            DateTime       @default(now())
  removedAt            DateTime?
  removalReason        String?        @db.VarChar(250)
  removedByUserId       Int?
  ticket               Ticket         @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  removedByUser        User? @relation("AttachmentRemovedBy", fields: [removedByUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, removedAt])
}
