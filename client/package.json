{
  "name": "toktickit-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:evidence": "playwright test e2e/lab-02/responsive.spec.ts",
    "test:e2e:lab3-evidence": "playwright test e2e/lab-03/release-evidence.spec.ts",
    "test:e2e:lab4-actions-evidence": "playwright test e2e/lab-04/actions-taken-flow.spec.ts",
    "test:e2e:lab4-workflow-evidence": "playwright test e2e/lab-04/ticket-resolution.spec.ts",
    "test:e2e:review": "playwright test --config playwright.dashboard-review.config.ts",
    "test:e2e:lab4-dashboard-evidence": "playwright test --config playwright.dashboard-review.config.ts e2e/lab-04/dashboards.spec.ts"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
